// Brindle data model. See docs/data-model.md.
// Database objects use snake_case via @map/@@map; Prisma models keep camelCase.
// CHECK constraints and append-only triggers live in the migration SQL because
// Prisma's schema language cannot express them.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// Declaration order is the PostgreSQL sort order.
enum Role {
  ADMIN
  TEAM_MEMBER

  @@map("role")
}

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  COMPLETED
  CANCELLED

  @@map("work_order_status")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("priority")
}

enum ActivityType {
  CREATED
  STATUS_CHANGED
  ASSIGNEE_CHANGED
  PRIORITY_CHANGED
  DUE_DATE_CHANGED
  DETAILS_UPDATED
  COMMENT_ADDED

  @@map("activity_type")
}

/// Better Auth core user fields (name, email, emailVerified, image, createdAt, updatedAt)
/// plus server-owned domain fields role and isActive (Better Auth additionalFields with
/// input: false). Sessions and credential accounts are Better Auth tables (Phase 4A).
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  role          Role     @default(TEAM_MEMBER)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignedWorkOrders WorkOrder[]         @relation("WorkOrderAssignee")
  createdWorkOrders  WorkOrder[]         @relation("WorkOrderCreator")
  comments           WorkOrderComment[]
  activities         WorkOrderActivity[]
  sessions           Session[]
  accounts           Account[]

  @@index([role, isActive])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Better Auth 1.7.7 tables. Field names match Better Auth's core schema
// (better-auth core db/get-tables) exactly; the Prisma adapter addresses them by
// these Prisma names, so the snake_case database mapping is transparent to it.
// ---------------------------------------------------------------------------

/// Database-backed session. The token is the opaque value carried by the session cookie.
model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Authentication method linked to a user. Email/password sign-in uses
/// providerId = "credential" with accountId = the user's id; `password` holds the hash.
model Account {
  id                    String    @id @default(cuid())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

/// Short-lived verification values (unused in the MVP; required by Better Auth's schema).
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

model ServiceArea {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(80)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workOrders WorkOrder[]

  @@map("service_areas")
}

model WorkOrder {
  id            String          @id @default(cuid())
  /// Human-readable reference, displayed as WO-000123.
  number        Int             @unique @default(autoincrement())
  title         String          @db.VarChar(120)
  description   String
  status        WorkOrderStatus @default(OPEN)
  priority      Priority        @default(MEDIUM)
  serviceAreaId String          @map("service_area_id")
  dueAt         DateTime        @map("due_at") @db.Timestamptz(3)
  assigneeId    String?         @map("assignee_id")
  createdById   String          @map("created_by_id")
  /// Optimistic-concurrency token; incremented on every mutation.
  version       Int             @default(0)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  completedAt   DateTime?       @map("completed_at") @db.Timestamptz(3)
  cancelledAt   DateTime?       @map("cancelled_at") @db.Timestamptz(3)

  serviceArea ServiceArea         @relation(fields: [serviceAreaId], references: [id], onDelete: Restrict)
  assignee    User?               @relation("WorkOrderAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  createdBy   User                @relation("WorkOrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  comments    WorkOrderComment[]
  activities  WorkOrderActivity[]

  @@index([status, dueAt])
  @@index([assigneeId, status])
  @@index([priority, status])
  @@index([serviceAreaId])
  @@index([createdById])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([completedAt])
  @@map("work_orders")
}

/// Immutable in the MVP; UPDATE and DELETE are blocked by a trigger.
model WorkOrderComment {
  id          String   @id @default(cuid())
  workOrderId String   @map("work_order_id")
  authorId    String   @map("author_id")
  body        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workOrder WorkOrder          @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  author    User               @relation(fields: [authorId], references: [id], onDelete: Restrict)
  activity  WorkOrderActivity?

  @@index([workOrderId, createdAt])
  @@index([authorId])
  @@map("work_order_comments")
}

/// Append-only audit trail; UPDATE and DELETE are blocked by a trigger.
model WorkOrderActivity {
  id          String           @id @default(cuid())
  workOrderId String           @map("work_order_id")
  actorId     String           @map("actor_id")
  type        ActivityType
  fromStatus  WorkOrderStatus? @map("from_status")
  toStatus    WorkOrderStatus? @map("to_status")
  /// Structured before/after values, e.g. {"priority":{"from":"LOW","to":"HIGH"}}.
  changes     Json?
  description String           @db.VarChar(500)
  commentId   String?          @unique @map("comment_id")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  workOrder WorkOrder         @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  actor     User              @relation(fields: [actorId], references: [id], onDelete: Restrict)
  comment   WorkOrderComment? @relation(fields: [commentId], references: [id], onDelete: Restrict)

  @@index([workOrderId, createdAt])
  @@index([createdAt])
  @@index([type, toStatus, createdAt])
  @@index([actorId])
  @@map("work_order_activities")
}
