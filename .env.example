# Sprikle Ops environment variables.
# Copy to `.env` for local development: cp .env.example .env
# Never commit real secrets. Every value here is a non-production placeholder.
# Variables are validated at runtime by src/lib/env.ts.

# IANA time zone used to interpret date-only due dates and to group analytics by day/week.
APP_TIMEZONE=America/New_York

# Added in later phases (not used yet):
# DATABASE_URL        (Phase 2: PostgreSQL)
# BETTER_AUTH_SECRET  (Phase 4: authentication)
# BETTER_AUTH_URL     (Phase 4: authentication)
# SEED_DEMO_PASSWORD  (Phase 4/5: demo accounts)
