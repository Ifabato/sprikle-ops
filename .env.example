# Brindle environment variables.
# Create your local .env with `pnpm env:init`: it copies this file, generates a random
# local PostgreSQL password, and fills in the connection URLs. It never overwrites an
# existing .env. This example contains no usable credentials; never commit .env.
# Variables are validated at runtime by src/lib/env.ts.

# Time zone used to interpret date-only due dates and to group analytics by day/week.
# The MVP supports America/New_York only; any other value fails configuration validation.
APP_TIMEZONE=America/New_York

# Local PostgreSQL (docker-compose.yml), published on 127.0.0.1 only.
POSTGRES_USER=sprikle
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Development database (sprikle_ops) used by the app and `prisma migrate dev`.
# Format: postgresql://POSTGRES_USER:POSTGRES_PASSWORD@127.0.0.1:POSTGRES_PORT/sprikle_ops
DATABASE_URL=

# Test database (must be exactly sprikle_ops_test on a local host; enforced by the test guard).
# Format: postgresql://POSTGRES_USER:POSTGRES_PASSWORD@127.0.0.1:POSTGRES_PORT/sprikle_ops_test
TEST_DATABASE_URL=

# Authentication (Better Auth). The secret signs session cookies: at least 32 characters,
# generated by `pnpm env:init` / `pnpm env:init --add-missing`. Never commit it.
BETTER_AUTH_SECRET=
# Public base URL of the app. http://localhost locally (cookies are not marked Secure);
# an https:// URL in production enables Secure, __Secure- prefixed cookies.
BETTER_AUTH_URL=http://localhost:3000

# Password for the synthetic @sprikle.test demo accounts created by `pnpm db:seed:auth`.
# Generated locally (at least 12 characters); it stays only in your ignored .env.
SEED_DEMO_PASSWORD=
